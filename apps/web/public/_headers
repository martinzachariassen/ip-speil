# Cloudflare applies these to static-asset responses. The page CSP lived in the
# Bun server's secure-headers middleware before the split; it lives here now that
# Cloudflare serves the HTML. All /api/* calls are same-origin ('self') because
# the Worker fronts them — only the direct browser probes need explicit origins.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://1.1.1.1 https://ipv4.icanhazip.com https://ipv6.icanhazip.com https://cloudflare-dns.com https://bash.ws https://*.bash.ws https://dnssec.works https://www.brokendnssec.net; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Accept-CH: Sec-CH-UA-Full-Version-List, Sec-CH-UA-Platform-Version, Sec-CH-UA-Arch, Sec-CH-UA-Model, Sec-CH-UA-Bitness

# Vite emits content-hashed JS/CSS and the design system's bundled WOFF2 fonts
# into /bundle/ (assetsDir "bundle") — all same-origin and safe to cache forever.
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
