{
  "name": "ip-speil",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "trap 'kill 0' EXIT INT TERM; bun run dev:api & bun run dev:web",
    "dev:api": "bun run --filter @ip-speil/api dev",
    "dev:web": "bun run --filter @ip-speil/web dev",
    "build": "bun run --filter @ip-speil/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run build && bun run typecheck && bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "^7.0.2"
  }
}
